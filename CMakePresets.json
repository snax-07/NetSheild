{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",

      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    },

    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Development",
      "description": "Development build with debug symbols and warnings.",

      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic"
      }
    },

    {
      "name": "release",
      "inherits": "base",
      "displayName": "Production Release",
      "description": "Optimized production build.",

      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },

    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "displayName": "Release With Debug Info",
      "description": "Optimized build retaining debug symbols.",

      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },

    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Address Sanitizer",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer.",

      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },

    {
      "name": "test",
      "inherits": "dev",
      "displayName": "Test Build",
      "description": "Development build configured for testing.",

      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 0
    },

    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 0
    },

    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "jobs": 0
    },

    {
      "name": "asan",
      "configurePreset": "asan",
      "jobs": 0
    },

    {
      "name": "test",
      "configurePreset": "test",
      "jobs": 0
    }
  ],

  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}